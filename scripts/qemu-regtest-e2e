    let img = CIImage(contentsOf: URL(fileURLWithPath: path))!
    let msgs = det.features(in: img).compactMap {{ ($0 as? CIQRCodeFeature)?.messageString }}
    guard msgs.first == want else {{
        fputs("QR MISMATCH for \\(path): got \\(msgs) want \\(want)\\n", stderr)
        exit(1)
    }}
    print("ok    CoreImage decoded live QEMU ramfb QR: \\(URL(fileURLWithPath: path).lastPathComponent)")
}}
