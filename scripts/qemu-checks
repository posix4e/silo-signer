#!/usr/bin/env bash
# Runs all 9 bare-metal AArch64 MMU protection & hardware self-checks in QEMU -M virt -cpu max:
#   - `none`: verifies DIT=true, RNDR=true, FDT parse, VirtIO-MMIO v2 discovery, SelfTest, BigNat -> exit 0
#   - 8 forbidden accesses (W^X, RO, null page, stack overflow on SP_EL1, beside-device) -> MUST fault & exit 3!
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
img="$root/build/bare-probe-qemu-regtest/Image"
[ -f "$img" ] || { echo "qemu-checks: missing $img (run scripts/build-bare probe qemu regtest)" >&2; exit 2; }

run_one() {
  local chk="$1"
  local want_exit="$2"
  local want_grep="$3"
  local out
  out="$(qemu-system-aarch64 \
    -M virt -cpu max -m 512M -nographic -monitor none \
    -global virtio-mmio.force-legacy=false \
    -kernel "$img" \
    -append "check=$chk" \
    -device virtio-rng-device \
    -no-reboot 2>&1)"
  if ! printf '%s\n' "$out" | grep -q "TRICORDER_EXIT=$want_exit"; then
    echo "FAIL  check=$chk: expected TRICORDER_EXIT=$want_exit" >&2
    printf '%s\n' "$out" >&2
    exit 1
  fi
  if ! printf '%s\n' "$out" | grep -q "$want_grep"; then
    echo "FAIL  check=$chk: missing expected output '$want_grep'" >&2
    printf '%s\n' "$out" >&2
    exit 1
  fi
  echo "ok    AArch64 bare-metal check=$chk (TRICORDER_EXIT=$want_exit)"
}

# Positive baseline + CPU/FDT/VirtIO/RNG/SelfTest checks
out_none="$(qemu-system-aarch64 \
  -M virt -cpu max -m 512M -nographic -monitor none \
  -global virtio-mmio.force-legacy=false \
  -kernel "$img" \
  -append "check=none" \
  -device virtio-rng-device \
  -no-reboot 2>&1)"
for needle in \
  "DIT=true RNDR=true" \
  "FDT OK:" \
  "virtio-mmio v2 device id=4" \
  "RNDR health-checked 32B:" \
  "virtio-rng 32B:" \
  "SelfTest SHA-256:" \
  "BigNat bare-metal check: true" \
  "check: nothing forbidden was tried" \
  "TRICORDER_EXIT=0"; do
  if ! printf '%s\n' "$out_none" | grep -q "$needle"; then
    echo "FAIL  check=none missing '$needle'" >&2
    printf '%s\n' "$out_none" >&2
    exit 1
  fi
done
echo "ok    AArch64 bare-metal check=none (DIT=true, RNDR=true, FDT, VirtIO v2, SelfTest, BigNat)"

# 8 forbidden memory operations MUST trigger AArch64 EL1 synchronous aborts (exit 3)!
run_one write-code     3 "data abort"
run_one write-constant 3 "data abort"
run_one run-data       3 "instruction abort"
run_one run-heap       3 "instruction abort"
run_one run-stack      3 "instruction abort"
run_one read-zero      3 "data abort"
run_one overflow       3 "stack overflow caught"
run_one beside-device  3 "data abort"

echo "qemu-checks: ALL 9 BARE-METAL AARCH64 MMU & HARDWARE CHECKS PASSED!"
